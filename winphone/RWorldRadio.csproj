<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">ARM</Platform>
    <ProjectGuid>{2F8C41A6-6B0E-4E1C-9C3D-7A5B2E0D9F14}</ProjectGuid>
    <OutputType>AppContainerExe</OutputType>
    <RootNamespace>RWorldRadio</RootNamespace>
    <AssemblyName>RWorldRadio</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <TargetPlatformIdentifier>UAP</TargetPlatformIdentifier>
    <!-- TargetPlatformVersion is the SDK used to COMPILE; TargetPlatformMinVersion
         is what MSBuild stamps into AppxManifest as the minimum OS, and therefore
         what decides whether a phone will install the package at all.
         Editing MinVersion in Package.appxmanifest by hand does NOT work - MSBuild
         overwrites it from the value below.

         10586 is Windows 10 Mobile 1511, which is what this was tested against
         (a Lumia 920). A phone on 10586 silently refuses a package that asks for
         14393: tapping install does nothing at all, with no error.

         Note the compiler does not enforce this minimum - reference assemblies come
         from the 19041 SDK, so a 1607-era API like MediaPlayer.PlaybackSession
         compiles fine here and then crashes on the device. See Services/RadioPlayer.cs.
         Restore needs to run after changing this value. -->
    <TargetPlatformVersion>10.0.19041.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.10586.0</TargetPlatformMinVersion>
    <MinimumVisualStudioVersion>14</MinimumVisualStudioVersion>
    <EnableDotNetNativeCompatibleProfile>true</EnableDotNetNativeCompatibleProfile>
  </PropertyGroup>

  <!-- ARM is what Windows 10 Mobile runs. x86 is only useful for the emulator. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|ARM'">
    <OutputPath>bin\ARM\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <PlatformTarget>ARM</PlatformTarget>
    <UseVSHostingProcess>false</UseVSHostingProcess>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|ARM'">
    <OutputPath>bin\ARM\Release\</OutputPath>
    <DefineConstants>TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <Optimize>true</Optimize>
    <PlatformTarget>ARM</PlatformTarget>
    <UseDotNetNativeToolchain>true</UseDotNetNativeToolchain>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
    <OutputPath>bin\x86\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;NETFX_CORE;WINDOWS_UWP</DefineConstants>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
